{
  "name": "jitterbit-order-api",
  "version": "1.1.0",
  "private": true,
  "description": "API de pedidos com mapping de dados, MongoDB, JWT e OpenAPI, criada a partir de um desafio técnico.",
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "swagger-ui-express": "^5.0.1"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "check": "npm run check:syntax && npm test"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
